# Database & Local Storage
DATABASE_URL=file:./data/app.db
CACHE_DIR=./data/cache

# Admin API Bearer Token (required for /api/admin/*)
ADMIN_TOKEN=change-me-to-a-strong-random-token

# Optional: Bilibili cookies for higher stability when fetching dynamics
BILI_SESSDATA=
BILI_BUVID3=

# Optional: Fan creations sync tags (comma-separated)
FANART_TAGS=風見ロク,风见陆陆,iRuru,银潮project
FANART_AUTO_APPROVE=false

# Optional: Gemini API Key & Model for automatic weekly schedule image parsing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Cloudflare Tunnel Token (required for cloudflared service)
TUNNEL_TOKEN=

# Optional: Cloudflare R2 (leave empty to use local ./data/cache/ storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
